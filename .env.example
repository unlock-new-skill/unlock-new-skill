# --- Database (Prisma / Postgres) ---
# Supabase: Project Settings > Database > Connection string (URI).
# For serverless on Vercel prefer the pooled connection (port 6543, ?pgbouncer=true).
# For `prisma db push`/migrations use a DIRECT connection (port 5432).
DATABASE_URL="postgresql://user:pass@host:5432/postgres?schema=public"

# --- Cloudflare R2 (file uploads: images + CV PDF) ---
# S3 API endpoint (KHÔNG kèm tên bucket): https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://xxxxxxxx.r2.cloudflarestorage.com
R2_ACCESS_KEY=xxxxxxxxxxxxxxxx
R2_SECRET_KEY=xxxxxxxxxxxxxxxx
R2_BUCKET=mee
# Domain chính; public read mặc định = https://<R2_BUCKET>.<MAIN_DOMAIN> (bind domain này cho bucket trong R2 Settings)
MAIN_DOMAIN=victorpham.dev
# Hoặc set thẳng public base URL nếu khác quy ước <bucket>.<domain> (KHÔNG dấu / cuối):
# R2_PUBLIC_BASE_URL=https://mee.victorpham.dev

# --- Admin auth (1 user) ---
ADMIN_PASSWORD=doi-mat-khau-nay                    # mật khẩu đăng nhập /admin
AUTH_SECRET=chuoi-ngau-nhien-toi-thieu-32-ky-tu    # ký JWT cookie (openssl rand -base64 32)
